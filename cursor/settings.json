{
  "editor.fontFamily": "JetBrains Mono, Fira Code",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "editor.tabSize": 2,
  "editor.renderWhitespace": "none",
  "editor.renderLineHighlight": "none",
  "editor.showFoldingControls": "never",
  "editor.minimap.enabled": false,
  "editor.hover.enabled": true,
  "editor.lightbulb.enabled": "off",
  "editor.renderControlCharacters": false,
  "editor.mouseWheelZoom": true,
  "editor.scrollbar.verticalScrollbarSize": 2,
  "editor.scrollbar.horizontalScrollbarSize": 2,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.linkedEditing": true,
  "editor.codeActionsOnSave": {},
  "eslint.run": "onSave",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "html.autoClosingTags": true,
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      // "source.fixAll": "explicit",
    },
  },
  "python.languageServer": "None",
  "python.createEnvironment.trigger": "off",
  "cursorpyright.analysis.autoImportCompletions": true,
  "cursorpyright.analysis.autoSearchPaths": true,
  "cursorpyright.analysis.typeCheckingMode": "standard",
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontWeight": 450,
  "terminal.integrated.fontWeightBold": 800,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/__pycache__": true,
    ".DS_Store": true,
  },
  "extensions.ignoreRecommendations": true,
  "git.decorations.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "git.autoRepositoryDetection": true,
  "git.repositoryScanMaxDepth": 3,
  "gitlens.codeLens.authors.enabled": false,
  "gitlens.currentLine.enabled": true,
  "gitlens.codeLens.recentChange.enabled": true,
  "scm.diffDecorations": "none",
  "diffEditor.ignoreTrimWhitespace": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.layoutControl.type": "menu",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.activityBar.location": "hidden",
  // "workbench.editor.showTabs": "none",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.statusBar.visible": false,
  "workbench.activityBar.orientation": "vertical",
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.colorCustomizations": {
    "[Default Dark Modern]": {
      "titleBar.activeBackground": "#1e1e1e",
      "titleBar.inactiveBackground": "#1e1e1e",
      "titleBar.border": "#1e1e1e",

      // // tab strip container
      "editorGroupHeader.tabsBackground": "#1e1e1e",
      "editorGroupHeader.tabsBorder": "#1e1e1e",
      "editorGroupHeader.border": "#1e1e1e",
      "editorGroup.border": "#1e1e1e",

      // the tabs themselves
      "tab.activeBackground": "#1e1e1e",
      "tab.inactiveBackground": "#1e1e1e",
      "tab.hoverBackground": "#1e1e1e",
      "tab.unfocusedActiveBackground": "#1e1e1e",
      "tab.unfocusedInactiveBackground": "#1e1e1e",
      "tab.unfocusedHoverBackground": "#1e1e1e",

      // kill the separators and the accent line
      // "tab.border": "#1e1e1e",
      // "tab.activeBorder": "#1e1e1e",
      // "tab.activeBorderTop": "#1e1e1e",
      // "tab.unfocusedActiveBorder": "#1e1e1e",
      // "tab.unfocusedActiveBorderTop": "#1e1e1e",
      // "tab.lastPinnedBorder": "#1e1e1e",

      "breadcrumb.background": "#1e1e1e",
      "editor.background": "#1e1e1e",
    },
    "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
          "scope": [
            "comment",
            "keyword",
            "variable.language",
            "meta.var.expr",
            "storage.modifier",
            "storage.type",
            "entity.other.attribute-name",
            "entity.name.type",
            "entity.name.class",
            "markup.italic",
            "markup.quote",
            "source.js",
            "source.jsx",
            "source.ts",
            "source.tsx",
            "storage.type.ts",
            "entity.name.function.js",
            "storage.modifier.tsx",
            "storage.type.tsx",
            "meta.type.cast.ts",
            "entity.name.type.ts",
            "keyword.control.flow.tsx",
            "meta.block.tsx",
            "meta.function.expression.tsx",
            "meta.export.default.tsx",
            "source.tsx",
            "comment",
            "meta.var.expr storage.type",
            "keyword.control.flow",
            "keyword.control.return",
            "meta.directive.vue punctuation.separator.key-value.html",
            "meta.directive.vue entity.other.attribute-name.html",
            "tag.decorator.js entity.name.tag.js",
            "tag.decorator.js punctuation.definition.tag.js",
            "storage.modifier",
          ],
          "settings": {
            "fontStyle": "",
          },
        },
      ],
    },
  },
  "window.commandCenter": true,
  "window.zoomLevel": 0,
  "window.titleBarStyle": "custom",
  "window.autoDetectColorScheme": false,
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"],
    },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["K"],
      "commands": ["lineBreakInsert"],
      "silent": true,
    },
  ],
  "vim.useSystemClipboard": true,
  "scm.alwaysShowRepositories": false,
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-auto",
}
