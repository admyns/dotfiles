// Command IDs and "when" context keys are case-sensitive.
[
  // ── Terminal ──
  {
    "key": "cmd+t",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminal.active",
  },
  {
    "key": "cmd+shift+t",
    "command": "workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile",
  },
  {
    "key": "cmd+shift+k",
    "command": "workbench.action.terminal.kill",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile",
  },
  {
    "key": "cmd+k",
    "command": "workbench.action.terminal.clear",
    "when": "terminalFocus",
  }, // default, kept for reference

  // ── Lists (vim-style) ──
  {
    "key": "g g",
    "command": "list.focusFirst",
    "when": "listFocus && !inputFocus",
  },
  {
    "key": "shift+g",
    "command": "list.focusLast",
    "when": "listFocus && !inputFocus",
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "listFocus && !inputFocus",
  },
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "listFocus && !inputFocus",
  },
  { "key": "k", "command": "list.focusUp", "when": "listFocus && !inputFocus" },
  { "key": "l", "command": "list.select", "when": "listFocus && !inputFocus" },
  {
    "key": "enter",
    "command": "list.select",
    "when": "listFocus && !inputFocus",
  }, // default, kept for reference
  {
    "key": "o",
    "command": "list.toggleExpand",
    "when": "listFocus && !inputFocus",
  },
  {
    "key": "ctrl+u",
    "command": "list.focusPageUp",
    "when": "listFocus && !inputFocus",
  },
  {
    "key": "ctrl+d",
    "command": "list.focusPageDown",
    "when": "listFocus && !inputFocus",
  },

  // ── File explorer ──
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "d",
    "command": "deleteFile",
    "when": "filesExplorerFocus && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "y",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && !explorerResourceIsRoot && !inputFocus",
  },
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && !explorerResourceIsRoot && !inputFocus",
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "v",
    "command": "explorer.openToSide",
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "shift+a",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus && !inputFocus",
  },

  // ── Pane navigation ──
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "editorTextFocus",
  },
  { "key": "ctrl+j", "command": "workbench.action.navigateDown" },
  { "key": "ctrl+k", "command": "workbench.action.navigateUp" },
  { "key": "ctrl+l", "command": "workbench.action.navigateRight" },

  // ctrl+j / ctrl+k in popups (below pane navigation so they take priority)
  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible && suggestWidgetMultipleSuggestions && editorTextFocus",
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible && suggestWidgetMultipleSuggestions && editorTextFocus",
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenNavigateNext",
    "when": "inQuickOpen",
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenNavigatePrevious",
    "when": "inQuickOpen",
  },
  {
    "key": "ctrl+j",
    "command": "selectNextCodeAction",
    "when": "codeActionMenuVisible",
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevCodeAction",
    "when": "codeActionMenuVisible",
  },

  // ── Views & layout ──
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "sideBarFocus",
  },
  { "key": "cmd+shift+x", "command": "workbench.view.extensions" }, // default, kept for reference
  { "key": "cmd+shift+d", "command": "workbench.view.debug" }, // default, kept for reference
  { "key": "cmd+shift+g", "command": "workbench.view.scm" },
  { "key": "cmd+shift+l", "command": "workbench.view.search" },
  { "key": "cmd+shift+u", "command": "workbench.view.testing.focus" },
  {
    "key": "cmd+shift+a",
    "command": "workbench.action.toggleActivityBarVisibility",
  },
  {
    "key": "cmd+shift+b",
    "command": "workbench.action.toggleStatusbarVisibility",
  },
  {
    "key": "cmd+l",
    "command": "workbench.panel.chat",
    "when": "workbench.panel.chat.view.copilot.active",
  },

  // ── Editor ──
  { "key": "cmd+shift+0", "command": "workbench.action.openRecent" },
  { "key": "cmd+shift+v", "command": "workbench.action.splitEditorRight" },
  {
    "key": "cmd+shift+m",
    "command": "markdown.showPreview",
    "when": "editorLangId == 'markdown' && !notebookEditorFocused",
  },
  {
    "key": "cmd+r",
    "command": "editor.action.goToReferences",
    "when": "editorHasReferenceProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor",
  },

  // ── Removed defaults ──
  // cmd+i: disabled
  { "key": "cmd+i", "command": "-inlineChat.start" },
  { "key": "cmd+i", "command": "-workbench.action.terminal.chat.start" },
  { "key": "cmd+i", "command": "-workbench.action.chat.startVoiceChat" },
  {
    "key": "cmd+i",
    "command": "-workbench.action.chat.stopListeningAndSubmit",
  },
  { "key": "cmd+i", "command": "-editor.action.triggerSuggest" },
  { "key": "cmd+i", "command": "-toggleSuggestionDetails" },

  // cmd+shift+i: disabled
  { "key": "cmd+shift+i", "command": "-workbench.action.chat.openAgent" },
  { "key": "cmd+shift+i", "command": "-workbench.action.quickchat.toggle" },

  // freed or replaced keys
  { "key": "cmd+t", "command": "-workbench.action.showAllSymbols" },
  { "key": "cmd+shift+t", "command": "-workbench.action.reopenClosedEditor" },
  { "key": "cmd+shift+m", "command": "-workbench.actions.view.problems" },
  { "key": "cmd+shift+h", "command": "-workbench.action.replaceInFiles" },
  { "key": "ctrl+cmd+i", "command": "-workbench.action.chat.open" },
  { "key": "ctrl+r", "command": "-workbench.action.openRecent" },
  { "key": "ctrl+b", "command": "-workbench.action.toggleSidebarVisibility" },
  { "key": "ctrl+b", "command": "-vscode-neovim.send" },
  { "key": "up", "command": "-selectPrevCodeAction" },
  { "key": "down", "command": "-selectNextCodeAction" },
]
