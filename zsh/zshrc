# lifecycle (is the box on?) + in-flight runs (what's running, on which dataset).
bench-status() {
  local state
  state=$(aws ec2 describe-instances --profile $BENCH_PROFILE --instance-ids $BENCH_ID \
    --query 'Reservations[].Instances[].State.Name' --output text 2>/dev/null)
  echo "instance: ${state:-unknown}"
  [ "$state" != "running" ] && { echo "(box not running — nothing to inspect)"; return 0; }
  ssh bench -t '
    echo "=== runs in flight (dataset = the id argument) ==="
    pgrep -af "cover-instance.sh|run-instance.sh" | grep -v pgrep || echo "  none"
    echo "=== tmux sessions ==="
    tmux ls 2>/dev/null || echo "  none"
    echo "=== sandbox containers ==="
    docker ps --format "  {{.Names}}\t{{.Status}}" | grep -v registry-mirror || echo "  none (besides registry-mirror)"
  '
}

# store the Claude OAuth token in the macOS keychain (run once). paste at the prompt.
bench-token() {
  security add-generic-password -U -s claude-oauth -a "$USER" -w \
    && echo "stored in keychain (service: claude-oauth). bench-run cover will use it automatically."
}

# start a cover or grader batch on the box, parallel (default) or sequential.
#
#   bench-run cover <target-id> [id2 ...]        # slice ids (per-dataset runner.json) or dataset names
#   bench-run run   <dataset:instance> [...]     # grader; e.g. calcom:c1 plane:p1
#   bench-run sandbox <dataset-name> [...]       # generation: bare repo -> sandbox (dev:sandbox)
#
# cover picks its sandbox automatically: the repo's latest generation when one exists, else the
# sandbox committed in the dataset repo — so gen -> cover chains with no flags:
#   bench-run sandbox heal-sisyf-dataset && bench-run cover sis-athlete-plan
# override when needed: SANDBOX_REF=gen-<repo>-<run-id> pins a specific generation,
# SANDBOX_REF=repo forces the committed sandbox, SANDBOX_REF=latest requires a generation (errors
# if none). The choice is always recorded in the cover run's out dir (sandbox-ref.txt).
#
# parallel is the default; add -s (or SEQ=1) for sequential.
#   - cover delegates to cover-all.sh, which admits runs by a RAM budget so the Docker
#     VM never thrashes. Parallel = its own scheduler; sequential = MAX_PARALLEL=1.
#     Only cover needs the Claude token (pulled from keychain; ANTHROPIC_API_KEY unset so OAuth wins).
#   - run has no memory scheduler, so parallel = one detached tmux session per pair; keep it small.
# batch id defaults to r1 -> override with LABEL=t2.
# examples:
#   bench-run cover pen-payees fpy-bank-account-create        # budgeted parallel cover
#   SEQ=1 bench-run cover cal-availability-default cal-booking-invitee
#   bench-run run calcom:c1 plane:p1                          # two graders in parallel
bench-run() {
  local seq="${SEQ:-0}"
  if [ "$1" = "-s" ] || [ "$1" = "--seq" ]; then seq=1; shift; fi

  local action="$1"; shift
  local label="${LABEL:-r1}" dir='~/heal/datasets/heal-sandbox-runner'

  case "$action" in
    cover)
      [ $# -eq 0 ] && { echo "usage: bench-run [-s] cover <target-id> [id2 ...]"; return 1; }
      local tok; tok=$(security find-generic-password -s claude-oauth -w 2>/dev/null)
      [ -z "$tok" ] && { echo "no token in keychain — run 'bench-token' first." >&2; return 1; }
      local cap=""; [ "$seq" = 1 ] && cap="MAX_PARALLEL=1 "
      # forward SDK_DIR if set (e.g. the studio SDK that still has dev:cover, until main
      # gets a headless cover entry back). unset -> the runner defaults to ~/heal/heal-claude-sdk.
      local sdk_env=""; [ -n "${SDK_DIR:-}" ] && sdk_env="SDK_DIR=$SDK_DIR "
      # cover a generated sandbox instead of the repo's committed one (latest | gen-<repo>-<run-id>)
      [ -n "${SANDBOX_REF:-}" ] && sdk_env="${sdk_env}SANDBOX_REF=$SANDBOX_REF "
      # NOTE: env must be set INSIDE the tmux command — a new-session attaching to an
      # already-running tmux server inherits the server's env, not the client's, so
      # `env VAR=... tmux ...` silently drops the token.
      # Detached (-d): launch and return to your prompt; attach later to watch (see hint below).
      ssh bench "tmux new-session -d -s cover-\$USER \
        'cd $dir; env -u ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN=$tok ${sdk_env}${cap}RUN_ID=$label ./cover-all.sh $*; echo [ALL DONE]; exec bash'"
      echo "launched cover ($*) in tmux 'cover-$USER'."
      echo "watch:  ssh bench -t 'tmux attach -t cover-$USER'    status: bench-status"
      ;;
    run)
      [ $# -eq 0 ] && { echo "usage: bench-run [-s] run <dataset:instance> [...]   e.g. calcom:c1 plane:p1"; return 1; }
      if [ "$seq" = 1 ]; then
        local body="cd $dir;"
        local pair d i
        for pair in "$@"; do
          d="${pair%%:*}"; i="${pair##*:}"
          body="$body echo \"=== $d/$i ===\"; ./run-instance.sh $d $i || echo \"FAILED: $pair\";"
        done
        ssh bench -t "tmux new-session -A -s run-\$USER '$body echo [all done]; exec bash'"
      else
        local pair d i
        for pair in "$@"; do
          d="${pair%%:*}"; i="${pair##*:}"
          ssh bench "tmux new-session -d -s run-$d-$i 'cd $dir; ./run-instance.sh $d $i; echo [DONE $pair]; exec bash'"
          echo "launched run-$d-$i"
        done
        echo "watch: bench-status   (no RAM scheduler on the run path — keep parallel small)"
      fi
      ;;
    sandbox)
      # generation: agent turns a bare app repo into a sandbox (dev:sandbox — exists on main,
      # so no SDK_DIR override needed; forwarded if you set one anyway).
      # optional env passthrough: BRANCH (eval-input branch), MODE (skeleton|grow).
      [ $# -eq 0 ] && { echo "usage: bench-run [-s] sandbox <dataset-dir-name> [more...]   e.g. heal-sisyf-dataset"; return 1; }
      local tok; tok=$(security find-generic-password -s claude-oauth -w 2>/dev/null | tr -d '[:space:]')
      [ -z "$tok" ] && { echo "no token in keychain — run 'bench-token' first." >&2; return 1; }
      local gen_env="env -u ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN=$tok"
      [ -n "${SDK_DIR:-}" ] && gen_env="$gen_env SDK_DIR=$SDK_DIR"
      [ -n "${BRANCH:-}" ] && gen_env="$gen_env BRANCH=$BRANCH"
      [ -n "${MODE:-}" ] && gen_env="$gen_env MODE=$MODE"
      local repo
      if [ "$seq" = 1 ]; then
        local body="cd $dir;"
        for repo in "$@"; do
          body="$body echo \"=== $repo ($label) ===\"; $gen_env ./sandbox-instance.sh $repo $label || echo \"FAILED: $repo\";"
        done
        ssh bench -t "tmux new-session -A -s gen-\$USER '$body echo [all done]; exec bash'"
      else
        for repo in "$@"; do
          ssh bench "tmux new-session -d -s gen-$repo \
            'cd $dir; $gen_env ./sandbox-instance.sh $repo $label; echo [DONE $repo]; exec bash'"
          echo "launched gen-$repo"
        done
        echo "watch: bench-status   |   attach: ssh bench -t 'tmux attach -t gen-<repo>'"
      fi
      ;;
    *)
      echo "usage: bench-run [-s] <cover|run|sandbox> <id...>" >&2
      return 1
      ;;
  esac
}
